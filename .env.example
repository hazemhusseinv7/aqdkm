# Copy to .env.local and fill in real values (never commit .env.local).
# cp .env.example .env.local

# Sanity - read path (homepage, blog, settings).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
# Sanity - writes. Editor-role token, server-only (Server Actions).
# Never prefix with NEXT_PUBLIC_.
SANITY_API_TOKEN=your-editor-token
# Sanity - webhook signature for POST /api/revalidate.
# Generate with: openssl rand -hex 32
# Must match the secret saved in the Sanity dashboard webhook settings
# (filter on post/category/author/siteSettings documents).
SANITY_REVALIDATE_SECRET=

# Site - public URL (sitemap, metadata). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend) - newsletter confirm/welcome mail.
RESEND_API_KEY=
# Verified sender identity, e.g. "AqdkM <noreply@example.com>".
RESEND_FROM=
# Newsletter audience segment (Resend dashboard). Optional - contacts sync
# without a segment when empty.
RESEND_SEGMENT_ID=
# Admin inbox for new-request notifications (all-fields table per submission).
# Missing/failed sends are logged server-side; submissions always succeed.
ADMIN_EMAIL=

# Studio - shared editor-visible token authorizing the "Publish & notify"
# action (NEXT_PUBLIC_ = embedded in the Studio bundle by design).
# Authorizes only idempotent broadcast-of-published-post calls.
# Generate with: openssl rand -hex 32
NEXT_PUBLIC_BROADCAST_TOKEN=
